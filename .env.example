# Groq LLM API key (required — server-side only, never expose in frontend)
GROQ_API_KEY=gsk_your_key_here

# Redis connection for the RQ job queue (optional — backend falls back to async threads automatically)
REDIS_URL=redis://localhost:6379/0

# Optional comma-separated extra CORS origins & regex (e.g., Vercel frontend URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Number of trusted reverse-proxy hops in front of FastAPI (Render = 1)
TRUSTED_PROXY_HOPS=1

# Global daily cap on Groq API calls to protect free-tier key spend
GROQ_DAILY_CALL_LIMIT=500

# Optional unused search provider keys (reserved in config.py; DuckDuckGo is used by default)
TAVILY_API_KEY=
BRAVE_API_KEY=
